{
  "name": "rza-clipper",
  "productName": "Rza Clipper",
  "version": "1.0.0",
  "description": "Turn long videos into viral short clips with automatic captions and 9:16 vertical reframing — Linux Desktop Edition by Rza Official.",
  "author": "Rza Official",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "build:whisper": "node scripts/build-whisper-linux.mjs",
    "build:whisper:cpu": "node scripts/build-whisper-linux.mjs --cpu-only",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:deb": "electron-forge make --targets=@electron-forge/maker-deb",
    "make:rpm": "electron-forge make --targets=@electron-forge/maker-rpm",
    "make:appimage": "npm run package && node scripts/build-appimage.mjs",
    "make:all": "npm run make && node scripts/build-appimage.mjs"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@fontsource-variable/dm-sans": "^5.2.5",
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/montserrat": "^5.2.5",
    "@fontsource-variable/noto-nastaliq-urdu": "^5.2.5",
    "@fontsource-variable/noto-sans-arabic": "^5.2.5",
    "@fontsource-variable/noto-sans-devanagari": "^5.2.5",
    "@fontsource-variable/oswald": "^5.2.5",
    "@fontsource-variable/playfair-display": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@fontsource/anton": "^5.2.5",
    "@fontsource/barlow-condensed": "^5.2.5",
    "@fontsource/kaushan-script": "^5.2.5",
    "@hugeicons/core-free-icons": "^1.0.0",
    "@hugeicons/react": "^1.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.74.0",
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "mediabunny": "^1.51.0",
    "onnxruntime-node": "1.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.4.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
